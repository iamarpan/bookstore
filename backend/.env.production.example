# Production Environment Variables Template
# Copy this to set up environment variables in Vercel Dashboard

# ===========================================
# REQUIRED FOR DEPLOYMENT
# ===========================================

# Node Environment
NODE_ENV=production

# Database Connection (Vercel Postgres or Supabase)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgresql://username:password@db.vercel.com:5432/bookstore_prod
DATABASE_URL=postgresql://postgres:FVu9&8b9kDqGP8*@db.iyffnwujmbwdeqvqkgqe.supabase.co:5432/postgres

# For Vercel Postgres with connection pooling:
# DATABASE_URL=postgres://default:xxx@xxx-pooler.region.postgres.vercel-storage.com:5432/verceldb?pgbouncer=true&connect_timeout=15
# POSTGRES_URL_NON_POOLING=postgres://default:xxx@xxx.region.postgres.vercel-storage.com:5432/verceldb

# JWT Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=1ca6f324d9a87595508c2d31ae4002d197c12d3c0ff1ce7491fab34266d5dc56119cc2d313544412c4351d7905c1d638301e7edaf7100970502382811b36c4cb
JWT_REFRESH_SECRET=

# JWT Token Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP Configuration
OTP_EXPIRY_MINUTES=5

# ===========================================
# OPTIONAL (Can be added later)
# ===========================================

# Twilio SMS Configuration (for OTP delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AWS S3 Configuration (for image upload)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Apple Push Notifications
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_PRIVATE_KEY_PATH=
APNS_PRODUCTION=true

# Redis (for caching - optional)
REDIS_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# ===========================================
# NOTES
# ===========================================

# 1. Never commit actual secrets to git
# 2. Set these in Vercel Dashboard: Settings > Environment Variables
# 3. Generate strong random strings for JWT secrets
# 4. Vercel Postgres URL format includes ?pgbouncer=true
# 5. Some services (Twilio, AWS) can be added post-deployment
