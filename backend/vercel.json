{
    "version": 2,
    "builds": [
        {
            "src": "api/*.ts",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/health",
            "destination": "/api/index.ts"
        },
        {
            "source": "/api-docs(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.ts"
        }
    ]
}